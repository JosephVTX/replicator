# ── Runtime ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Directory that holds the SQLite DB, replica projects, builds and opencode data.
# Must be a persistent volume in production.
DATA_DIR=/data

# Public origin of the platform (used for cookie security + absolute links).
PUBLIC_BASE_URL=https://replicate.129.146.63.224.sslip.io

# 32+ byte random secret for signing session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string-please-32-plus-bytes
# Set to false only when serving plain HTTP in local dev.
COOKIE_SECURE=true

# ── Bootstrap admin (created on first boot if no users exist) ──────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password

# ── opencode agent engine ──────────────────────────────────────────────────────
# The server spawns `opencode serve` on this port and talks to it via the SDK.
OPENCODE_PORT=4096
OPENCODE_HOSTNAME=127.0.0.1
# Protect the local opencode server with basic auth (internal only).
OPENCODE_SERVER_PASSWORD=change-me-opencode-internal
OPENCODE_SERVER_USERNAME=opencode

# Pre-installed skill workspace (Playwright scripts). In the container image this
# points at /opt/skill-ws; leave unset to use $DATA_DIR/skill-ws.
SKILL_WS=/opt/skill-ws
# Where Playwright keeps its browsers (baked into the image).
PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright

# ── Agent limits ───────────────────────────────────────────────────────────────
# Max concurrent replication jobs.
MAX_CONCURRENT_JOBS=2
# Hard wall-clock limit per replication run (ms).
JOB_TIMEOUT_MS=3600000
